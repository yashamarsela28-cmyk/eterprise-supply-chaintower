# =================================================================
# Backend Environment Configuration Template
# Copy this file to .env and provide your actual configuration values.
# NEVER commit the real .env file or production secrets to Git.
# =================================================================

# Server port (default: 5000)
PORT=5000

# Node environment: 'development' or 'production'
NODE_ENV=production

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Secret Service Role Key (Server-Side Only - NEVER expose to frontend)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Allowed CORS origins (comma-separated for multiple origins, or * for open dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
